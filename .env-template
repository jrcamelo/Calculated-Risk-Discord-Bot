# Discord API Token
BOT_TOKEN=

# Discord application/client ID, required for slash command deployment
CLIENT_ID=

# Optional guild ID for fast slash command deployment during testing
DEV_GUILD_ID=

# Folder where the database files will be saved
DATABASE_PATH=./storage/

# Prefix before every command
PREFIX=.

# Optional legacy prefix mode. Requires Discord Message Content intent approval.
ENABLE_PREFIX_COMMANDS=false

# Your user ID
OWNER=

